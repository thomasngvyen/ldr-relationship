generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")

  coupleAsA         Couple?            @relation("UserA")
  coupleAsB         Couple?            @relation("UserB")
  moodMessages      MoodMessage[]      @relation("UserMoodMessages")
  dateIdeas         DateIdea[]         @relation("UserDateIdeas")
  dateIdeaVotes     DateIdeaVote[]     @relation("UserDateIdeaVotes")
  visits            Visit[]            @relation("VisitingPartner")
  memoryImages      MemoryImage[]      @relation("UserMemoryImages")
  feelings          Feeling[]          @relation("UserFeelings")
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Couple {
  id         String   @id @default(cuid())
  inviteCode String   @unique @map("invite_code")
  userAId    String   @unique @map("user_a_id")
  userBId    String?  @unique @map("user_b_id")
  createdAt  DateTime @default(now()) @map("created_at")

  userA User  @relation("UserA", fields: [userAId], references: [id], map: "couples_user_a_fkey")
  userB User? @relation("UserB", fields: [userBId], references: [id], map: "couples_user_b_fkey")

  visits       Visit[]       @relation("CoupleVisits")
  dateIdeas    DateIdea[]    @relation("CoupleDateIdeas")
  moodMessages MoodMessage[] @relation("CoupleMoodMessages")
  memories     Memory[]      @relation("CoupleMemories")
  feelings     Feeling[]     @relation("CoupleFeelings")

  @@map("couples")
}

model Visit {
  id                String   @id @default(cuid())
  start_date        DateTime @map("start_date")
  end_date          DateTime @map("end_date")
  coupleId          String   @map("couple_id")
  couple            Couple   @relation("CoupleVisits", fields: [coupleId], references: [id], map: "visits_couple_fkey")
  createdAt         DateTime @default(now()) @map("created_at")
  visitingPartnerId String?  @map("visiting_partner_id")
  visitingPartner   User?    @relation("VisitingPartner", fields: [visitingPartnerId], references: [id], map: "visits_visiting_partner_fkey")
  memory            Memory?  @relation("VisitMemory")

  @@map("visits")
}

enum Mood {
  HAPPY
  SAD
  ANGRY
  EXCITED
  CONFUSED
  BORED
  TIRED
  SICK
  STRESSED
  RELAXED
  HORNY
  SLEEPY
}

model MoodMessage {
  id        String   @id @default(cuid())
  mood      Mood
  message   String
  createdAt DateTime @default(now())
  userId    String   @map("user_id")
  coupleId  String   @map("couple_id")
  user      User     @relation("UserMoodMessages", fields: [userId], references: [id])
  couple    Couple   @relation("CoupleMoodMessages", fields: [coupleId], references: [id], map: "mood_messages_couple_fkey", onDelete: Cascade)

  @@map("mood_messages")
}

model DateIdea {
  id          String           @id @default(cuid())
  title       String
  description String
  category    DateIdeaCategory
  status      DateIdeaStatus   @default(IDEA)
  coupleId    String           @map("couple_id")
  userId      String           @map("user_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  couple Couple         @relation("CoupleDateIdeas", fields: [coupleId], references: [id], map: "date_ideas_couple_fkey")
  user   User           @relation("UserDateIdeas", fields: [userId], references: [id], map: "date_ideas_user_fkey")
  votes  DateIdeaVote[] @relation("DateIdeaVotes")
  memory Memory?        @relation("DateIdeaMemory")

  @@map("date_ideas")
}

enum DateIdeaCategory {
  OUTDOOR
  INDOOR
  ACTIVE
  CASUAL
  ROMANTIC
  ADVENTUROUS
  COZY
}

enum DateIdeaStatus {
  IDEA
  VOTED
  SELECTED
  COMPLETED
}

model DateIdeaVote {
  id         String   @id @default(cuid())
  dateIdeaId String   @map("date_idea_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  dateIdea DateIdea @relation("DateIdeaVotes", fields: [dateIdeaId], references: [id], map: "date_idea_votes_date_idea_fkey", onDelete: Cascade)
  user     User     @relation("UserDateIdeaVotes", fields: [userId], references: [id], map: "date_idea_votes_user_fkey")

  @@unique([dateIdeaId, userId])
  @@map("date_idea_votes")
}

model Memory {
  id         String   @id @default(cuid())
  coupleId   String   @map("couple_id")
  visitId    String?  @unique @map("visit_id")
  dateIdeaId String?  @unique @map("date_idea_id")
  title      String?
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  couple   Couple        @relation("CoupleMemories", fields: [coupleId], references: [id], map: "memories_couple_fkey", onDelete: Cascade)
  visit    Visit?        @relation("VisitMemory", fields: [visitId], references: [id], map: "memories_visit_fkey", onDelete: Cascade)
  dateIdea DateIdea?     @relation("DateIdeaMemory", fields: [dateIdeaId], references: [id], map: "memories_date_idea_fkey", onDelete: Cascade)
  images   MemoryImage[]

  @@map("memories")
}

model MemoryImage {
  id           String   @id @default(cuid())
  memoryId     String   @map("memory_id")
  filename     String
  originalName String?  @map("original_name")
  mimeType     String?  @map("mime_type")
  caption      String?
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  memory     Memory @relation(fields: [memoryId], references: [id], map: "memory_images_memory_fkey", onDelete: Cascade)
  uploadedBy User   @relation("UserMemoryImages", fields: [uploadedById], references: [id], map: "memory_images_user_fkey")

  @@map("memory_images")
}

model Feeling {
  id        String   @id @default(cuid())
  feeling   String
  reason    String?
  coupleId  String   @map("couple_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  couple Couple @relation("CoupleFeelings", fields: [coupleId], references: [id], map: "feelings_couple_fkey", onDelete: Cascade)
  user   User   @relation("UserFeelings", fields: [userId], references: [id], map: "feelings_user_fkey")

  @@map("feelings")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
